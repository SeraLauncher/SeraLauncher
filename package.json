{
  "name": "sera-launcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @sera/client dev",
    "build": "bun --filter @sera/client build",
    "tauri": "bun --filter @sera/client tauri",
    "lint": "oxlint --react-plugin --import-plugin",
    "format": "oxfmt --ignore-path=.oxfmtignore .",
    "format:check": "oxfmt --check --ignore-path=.oxfmtignore .",
    "check": "bun run lint && bun run format:check && bun --filter '*' check"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "~6.0.3"
  }
}
