{
  "name": "seralauncher",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "mygo dev",
    "build": "mygo build",
    "generate": "mygo generate",
    "dev:web": "bun --filter @sera/client dev",
    "build:web": "bun --filter @sera/client build",
    "check": "bun run lint && bun --filter '*' check",
    "lint": "oxlint --ignore-path=.oxlintignore apps packages",
    "format": "oxfmt --ignore-path=.oxfmtignore .",
    "format:check": "oxfmt --check --ignore-path=.oxfmtignore .",
    "bump-version": "bun scripts/bump-version.ts"
  },
  "dependencies": {
    "mygo-runtime": "^0.7.4"
  },
  "devDependencies": {
    "mygo-cli": "^0.7.4",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "typescript": "^7",
    "vite": "^8"
  }
}
